# ==============================================================================
# ShareBite Environment Variables Template
# Copy this file to .env.local for local development, or set these in your
# deployment platform (Vercel, Docker, Railway, AWS, etc.) for production.
# ==============================================================================

# Node Environment
NODE_ENV=production

# Application URLs
# (Used for absolute redirects, metadata, and CORS whitelist)
NEXT_PUBLIC_APP_URL=https://sharebite.org
BACKEND_URL=https://sharebite.org

# Authentication Secrets
# CRITICAL: Generate a strong, random string at least 32 characters long
# Example command: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# Database Configuration
# For SQLite (default embedded):
DATABASE_PATH=./data/foodrescue.db
# For PostgreSQL (production alternative):
# DATABASE_URL=postgresql://user:password@host:5432/foodrescue?sslmode=require

# Initial Admin Bootstrap Credentials
# (Used only once during initial production database setup)
ADMIN_INITIAL_NAME=System Administrator
ADMIN_INITIAL_EMAIL=admin@sharebite.org
ADMIN_INITIAL_PASSWORD=replace_with_secure_admin_initial_password_123!

# AI / Vision Service API Keys
# Optional: If omitted, ShareBite runs in zero-dependency local heuristic fallback mode.
# Google Gemini API Key:
GEMINI_API_KEY=
# OpenAI API Key (alternative):
OPENAI_API_KEY=
# Custom ShareBite AI Endpoint:
AI_API_KEY=

# Mapping & Geocoding Services
# OpenStreetMap / Leaflet is used by default with zero API keys required.
# Mapbox or Google Maps Key (optional for satellite tiles or enhanced geocoding):
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_MAPBOX_TOKEN=
GOOGLE_MAPS_API_KEY=

# Security & Rate Limiting
# Max requests per window per IP
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Logging & Monitoring
LOG_LEVEL=info
SENTRY_DSN=
